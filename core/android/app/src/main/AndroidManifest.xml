<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 핵심 시스템 연동 및 전체 앱 패키지 가시성 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 2. 위치 및 공간 인식 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 3. 신체 활동 및 건강 센서 권한 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- 4. 카메라 및 비전 인식 권한 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 5. 전화 및 SMS 연동 권한 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 6. 블루투스 및 오디오 제어 (원거리 핫워드 게인 조절) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 7. 구글 캘린더 & 주소록 연동 권한 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 8. 외부 저장소 & 파일 접근 권한 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".YggdrasilApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="이그드라실"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 메인 액티비티 (One UI Jetpack Compose 화면) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 안드로이드 순정 시스템 어시스턴트 호출 (홈버튼 롱프레스 / 전원키 어시스트 인텐트 수신) -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 빅스비 캡슐 앱 실행 및 딥링크 핸들러 (yggdrasil://action, chat, launch, status, archive, settings) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="yggdrasil"
                    android:host="action" />
                <data
                    android:scheme="yggdrasil"
                    android:host="chat" />
                <data
                    android:scheme="yggdrasil"
                    android:host="launch" />
                <data
                    android:scheme="yggdrasil"
                    android:host="status" />
                <data
                    android:scheme="yggdrasil"
                    android:host="archive" />
                <data
                    android:scheme="yggdrasil"
                    android:host="settings" />
            </intent-filter>
        </activity>

        <!-- 화면 꺼짐(Screen-off) 상태 헤드리스 음성 질의 수신 브로드캐스트 리시버 -->
        <receiver
            android:name=".integration.YggdrasilHeadlessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.yggdrasil.assistant.action.HEADLESS_QUERY" />
                <action android:name="com.yggdrasil.assistant.action.HEADLESS_EXECUTE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="yggdrasil"
                    android:host="action" />
                <data
                    android:scheme="yggdrasil"
                    android:host="chat" />
            </intent-filter>
        </receiver>

        <!-- 접근성 서비스 (화면 자동 조작 및 터치) -->
        <service
            android:name=".operator.YggdrasilAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 알림 감지 서비스 (카카오톡, 문자, Gmail 후킹) -->
        <service
            android:name=".integration.NotificationCollectorService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 선제적 비서 시스템 이벤트 리시버 (배터리 부족, 알람 해제) -->
        <receiver
            android:name=".proactive.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="com.samsung.sec.android.clockpackage.alarm.ALARM_STOPPED" />
                <action android:name="com.google.android.deskclock.ALARM_DISMISSED" />
            </intent-filter>
        </receiver>

        <!-- 온디바이스 NPU 백그라운드 서비스 (C++ 데몬) -->
        <service
            android:name=".llm.LocalLlmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device NPU continuous AI assistant and headless voice synthesis" />
        </service>

        <!-- Android 순정 기본 디지털 어시스턴트 서비스 (VoiceInteractionService) -->
        <service
            android:name=".voice.YggdrasilVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- VoiceInteractionSession 세션 관리 서비스 -->
        <service
            android:name=".voice.YggdrasilVoiceSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- 순정 Voice Recognition 서비스 -->
        <service
            android:name=".voice.YggdrasilVoiceRecognitionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- 안드로이드 시스템 공식 자동 로그인 AutofillService -->
        <service
            android:name=".security.YggdrasilAutofillService"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- 갤럭시 버즈 및 블루투스 이어폰 미디어 버튼 / 헤드셋 훅 수신 리시버 -->
        <receiver
            android:name=".voice.BudsMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 파일 공유 안전 가드레일 (FileUriExposedException 원천 방어) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
