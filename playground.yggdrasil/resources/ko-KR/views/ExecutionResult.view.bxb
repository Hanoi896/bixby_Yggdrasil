result-view {
  match: ExecutionResult (this)

  message {
    template ("#{value(this.message)}")
  }

  app-launch {
    payload-uri ("#{value(this.appLaunchUri)}")
  }

  render {
    layout {
      section {
        content {
          if (exists(this.appLaunchUri)) {
            attribution-link {
              label {
                template ("🦅 이그드라실 앱에서 결과 확인")
              }
              url ("#{value(this.appLaunchUri)}")
            }
          }
          // One UI 카드 1: 궁니르 실행 상태 & 결과 메시지
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("🔱 Gungnir Execution")
                        style (Title_S)
                      }
                      text {
                        value ("영역: #{value(this.realm)} • 요구 권한: Level #{value(this.requiredLevel)}")
                        style (Detail_M_Soft)
                      }
                    }
                  }
                }
              }
              divider
              if (this.success) {
                single-line {
                  text {
                    value ("✅ 실행 승인 및 완료")
                    style (Title_M)
                  }
                }
              } else {
                single-line {
                  text {
                    value ("⛔ 실행 차단 (보안 거부)")
                    style (Title_M)
                  }
                }
              }
              paragraph {
                value ("#{value(this.message)}")
                style (Detail_L)
              }
            }
          }

          // One UI 카드 2: 세부 작업 및 서명 검증 정보
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("작업 유형")
                        style (Detail_M_Soft)
                      }
                      text {
                        value ("#{value(this.actionType)}")
                        style (Detail_L)
                      }
                    }
                  }
                  vbox {
                    content {
                      text {
                        value ("인가 요구 등급")
                        style (Detail_M_Soft)
                      }
                      text {
                        value ("Level #{value(this.requiredLevel)}")
                        style (Detail_L)
                      }
                    }
                  }
                }
              }
              divider
              single-line {
                text {
                  value ("서명 해시 검증: #{value(this.signedHash)}")
                  style (Legal)
                }
              }
            }
          }
        }
      }
    }
  }

  conversation-drivers {
    conversation-driver {
      template ("보안 상태 점검해줘")
    }
    conversation-driver {
      template ("판테온 상태 보여줘")
    }
    conversation-driver {
      template ("세계수 상태 보여줘")
    }
  }
}
