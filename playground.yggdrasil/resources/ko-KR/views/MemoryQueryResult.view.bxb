result-view {
  match: MemoryQueryResult (this)

  render {
    layout {
      section {
        content {
          // One UI 카드 1: 검색 헤더 및 요약 메시지
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("🦅 Munin Memory Recall")
                        style (Title_S)
                      }
                      if (exists(this.query)) {
                        text {
                          value ("검색어: '#{value(this.query)}' • 검색 결과 #{value(this.totalCount)}건")
                          style (Detail_M_Soft)
                        }
                      } else {
                        text {
                          value ("전체 기억 목록 • 총 #{value(this.totalCount)}건")
                          style (Detail_M_Soft)
                        }
                      }
                    }
                  }
                }
              }
              divider
              paragraph {
                value ("#{value(this.summaryMessage)}")
                style (Title_M)
              }
            }
          }

          // One UI 카드 2: 검색된 기억 목록
          if (this.totalCount > 0) {
            compound-card {
              content {
                single-line {
                  text {
                    value ("📋 회상된 일상 및 일정 기억")
                    style (Title_S)
                  }
                }
                for-each (this.records) {
                  as (record) {
                    paragraph {
                      value ("• [#{value(record.category)}] #{value(record.content)}")
                      style (Detail_L)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  conversation-drivers {
    conversation-driver {
      template ("오늘 일정 브리핑해줘")
    }
    conversation-driver {
      template ("판테온 상태 보여줘")
    }
  }
}
