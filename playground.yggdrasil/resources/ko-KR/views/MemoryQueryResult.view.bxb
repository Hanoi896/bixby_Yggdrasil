result-view {
  match: MemoryQueryResult (this)

  render {
    layout {
      section {
        content {
          // 상단 검색 뱃지
          hbox {
            content {
              vbox {
                content {
                  text {
                    value ("🦅 Munin Memory Recall")
                    style (Title_S)
                  }
                  if (exists(this.query)) {
                    text {
                      value ("검색어: '#{value(this.query)}' (총 #{value(this.totalCount)}건)")
                      style (Detail_M_Soft)
                    }
                  } else {
                    text {
                      value ("전체 기억 목록 (총 #{value(this.totalCount)}건)")
                      style (Detail_M_Soft)
                    }
                  }
                }
              }
            }
          }

          divider

          // 요약 메시지
          paragraph {
            value ("#{value(this.summaryMessage)}")
            style (Title_M)
          }

          divider

          // 검색된 레코드 카드 목록
          if (this.totalCount > 0) {
            single-line {
              text {
                value ("📋 회상된 일상 및 일정 기억")
                style (Title_S)
              }
            }
            for-each (this.records) {
              as (record) {
                paragraph {
                  value ("• [#{value(record.category)}] **#{value(record.content)}**")
                  style (Detail_L)
                }
              }
            }
          }
        }
      }
    }
  }
}
