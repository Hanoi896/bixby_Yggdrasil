result-view {
  match: HuginAdvice (this)

  render {
    layout {
      section {
        content {
          // 상단 브리핑 헤더
          hbox {
            content {
              vbox {
                content {
                  text {
                    value ("🦅 Hugin Strategic Intelligence")
                    style (Title_S)
                  }
                  text {
                    value ("주제: #{value(this.topic)} (신뢰도: #{value(this.confidence)}%)")
                    style (Detail_M_Soft)
                  }
                }
              }
            }
          }

          divider

          // 분석된 의도
          single-line {
            text {
              value ("🎯 파악된 의도")
              style (Title_S)
            }
          }
          paragraph {
            value ("#{value(this.intent)}")
            style (Detail_L)
          }

          divider

          // 최적 권고 사항
          single-line {
            text {
              value ("💡 휴긴의 맞춤 권고")
              style (Title_S)
            }
          }
          paragraph {
            value ("#{value(this.recommendation)}")
            style (Title_M)
          }

          divider

          // 실행 계획 (Action Plan)
          if (exists(this.actionPlan)) {
            single-line {
              text {
                value ("📋 수립된 행동 계획")
                style (Title_S)
              }
            }
            for-each (this.actionPlan) {
              as (plan) {
                paragraph {
                  value ("• #{value(plan)}")
                  style (Detail_L)
                }
              }
            }
            divider
          }

          // 추론 과정
          single-line {
            text {
              value ("🧠 심층 추론 과정")
              style (Detail_M_Soft)
            }
          }
          paragraph {
            value ("#{value(this.thoughtProcess)}")
            style (Detail_M_Soft)
          }
        }
      }
    }
  }
}
