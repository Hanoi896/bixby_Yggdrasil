result-view {
  match: HuginAdvice (this)

  message {
    template ("휴긴의 전략 분석 결과입니다. 이그드라실 앱에서 상세 대화를 이어갈 수 있습니다.")
  }

  app-launch {
    payload-uri ("#{value(this.appLaunchUri)}")
  }

  render {
    layout {
      section {
        content {
          if (exists(this.appLaunchUri)) {
            attribution-link {
              label {
                template ("🦅 이그드라실 앱에서 상담 이어가기")
              }
              url ("#{value(this.appLaunchUri)}")
            }
          }
          // One UI 카드 1: 의도 및 최적 권고
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("🦅 Hugin Strategic Intelligence")
                        style (Title_S)
                      }
                      text {
                        value ("주제: #{value(this.topic)} • 신뢰도: #{value(this.confidence)}%")
                        style (Detail_M_Soft)
                      }
                    }
                  }
                }
              }
              divider
              single-line {
                text {
                  value ("💡 후긴의 핵심 권고")
                  style (Title_S)
                }
              }
              paragraph {
                value ("#{value(this.recommendation)}")
                style (Title_M)
              }
              paragraph {
                value ("의도 분석: #{value(this.intent)}")
                style (Detail_M_Soft)
              }
            }
          }

          // One UI 카드 2: 수립된 행동 계획 (Action Plan)
          if (exists(this.actionPlan)) {
            compound-card {
              content {
                single-line {
                  text {
                    value ("📋 수립된 행동 계획")
                    style (Title_S)
                  }
                }
                for-each (this.actionPlan) {
                  as (plan) {
                    paragraph {
                      value ("• #{value(plan)}")
                      style (Detail_L)
                    }
                  }
                }
              }
            }
          }

          // One UI 카드 3: 추론 사고 과정
          compound-card {
            content {
              single-line {
                text {
                  value ("🧠 심층 추론 과정 (Thought Process)")
                  style (Detail_M_Soft)
                }
              }
              paragraph {
                value ("#{value(this.thoughtProcess)}")
                style (Detail_M_Soft)
              }
            }
          }
        }
      }
    }
  }

  conversation-drivers {
    conversation-driver {
      template ("방금 말한 거 다시 설명해줘")
    }
    conversation-driver {
      template ("거실 조명 켜기 실행해줘")
    }
    conversation-driver {
      template ("판테온 상태 보여줘")
    }
  }
}
