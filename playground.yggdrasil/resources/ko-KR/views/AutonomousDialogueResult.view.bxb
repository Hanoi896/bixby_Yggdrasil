result-view {
  match: AutonomousDialogueResult (this)

  message {
    template ("#{value(this.speechResponse)}")
  }

  app-launch {
    payload-uri ("#{value(this.appLaunchUri)}")
  }

  render {
    layout {
      section {
        content {
          // 상단 미니멀 브랜드 헤더
          hbox {
            content {
              vbox {
                content {
                  text {
                    value ("🦅 이그드라실 AI (온디바이스)")
                    style (Title_S)
                  }
                  text {
                    value ("100% 온디바이스 로컬 NPU 보안 연산")
                    style (Detail_M_Soft)
                  }
                }
              }
            }
          }

          divider

          // 사용자 질문 (Q 태그)
          if (exists(this.utterance)) {
            single-line {
              text {
                value ("Q. #{value(this.utterance)}")
                style (Detail_M_Soft)
              }
            }
          }

          // 상태 및 안내 본문
          paragraph {
            value ("#{value(this.displayText)}")
            style (Title_M)
          }

          spacer

          // 앱 즉시 이동 버튼 (원클릭 링크)
          if (exists(this.appLaunchUri)) {
            attribution-link {
              label {
                template ("🦅 이그드라실 앱에서 대화 열기")
              }
              url ("#{value(this.appLaunchUri)}")
            }
          }

          // 초고속 NPU 응답 안내
          if (exists(this.latencyMs)) {
            hbox {
              content {
                vbox {
                  content {
                    text {
                      value ("⚡ 초고속 온디바이스 핸드오프 (#{value(this.latencyMs)}ms)")
                      style (Detail_M_Soft)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // 후속 추천 발화 칩
  conversation-drivers {
    conversation-driver {
      template ("이그드라실 앱 열어줘")
    }
    conversation-driver {
      template ("오늘 주요 일정 알려줘")
    }
    conversation-driver {
      template ("배터리 절전 모드 켜줘")
    }
  }
}
