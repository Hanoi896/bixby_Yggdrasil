result-view {
  match: AutonomousDialogueResult (this)

  render {
    layout {
      section {
        content {
          // 상단 미니멀 브랜드 헤더
          hbox {
            content {
              vbox {
                content {
                  text {
                    value ("🦅 이그드라실 AI")
                    style (Title_S)
                  }
                  text {
                    value ("100% 온디바이스 로컬 보안 연산")
                    style (Detail_M_Soft)
                  }
                }
              }
            }
          }

          divider

          // 사용자 질문 (은은하게 Q 태그로 표시)
          if (exists(this.utterance)) {
            single-line {
              text {
                value ("Q. #{value(this.utterance)}")
                style (Detail_M_Soft)
              }
            }
          }

          // AI 메인 답변 (가독성 높은 본문 스타일)
          paragraph {
            value ("#{value(this.displayText)}")
            style (Title_M)
          }

          spacer

          // 하단 심플 안심 태그 (추론/세션ID 등 지저분한 디버그 정보 완전 삭제, 초고속 속도만 미니멀 표시)
          if (exists(this.latencyMs)) {
            hbox {
              content {
                vbox {
                  content {
                    text {
                      value ("⚡ 초고속 NPU 응답 (#{value(this.latencyMs)}ms)")
                      style (Detail_M_Soft)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // 실생활에서 바로 누르기 좋은 맞춤형 추천 발화 칩
  conversation-drivers {
    conversation-driver {
      template ("더 자세히 설명해줘")
    }
    conversation-driver {
      template ("오늘 주요 일정 알려줘")
    }
    conversation-driver {
      template ("화면 정리하고 홈으로 가줘")
    }
  }
}
