result-view {
  match: MemoryRecord (this)

  render {
    layout {
      section {
        content {
          // One UI 카드 1: 메모 내용 및 저장 확인
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("🦅 Munin Memory Storage")
                        style (Title_S)
                      }
                      text {
                        value ("Niflheim SQLCipher 암호화 기억 보관 완료")
                        style (Detail_M_Soft)
                      }
                    }
                  }
                }
              }
              divider
              paragraph {
                value ("#{value(this.content)}")
                style (Title_M)
              }
            }
          }

          // One UI 카드 2: 카테고리 및 암호화 서명
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("카테고리")
                        style (Detail_M_Soft)
                      }
                      text {
                        value ("#{value(this.category)}")
                        style (Detail_L)
                      }
                    }
                  }
                  vbox {
                    content {
                      text {
                        value ("암호화 상태")
                        style (Detail_M_Soft)
                      }
                      if (this.isEncrypted) {
                        text {
                          value ("🔒 SQLCipher 보호됨")
                          style (Detail_L)
                        }
                      } else {
                        text {
                          value ("일반 평문")
                          style (Detail_L)
                        }
                      }
                    }
                  }
                }
              }
              divider
              single-line {
                text {
                  value ("ID: #{value(this.id)} • 서명: #{value(this.signatureHash)}")
                  style (Legal)
                }
              }
            }
          }
        }
      }
    }
  }

  conversation-drivers {
    conversation-driver {
      template ("방금 저장한 기억 검색해줘")
    }
    conversation-driver {
      template ("판테온 상태 보여줘")
    }
  }
}
