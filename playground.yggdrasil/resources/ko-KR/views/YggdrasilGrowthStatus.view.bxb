result-view {
  match: YggdrasilGrowthStatus (this)

  message {
    template ("세계수 위그드라실의 성장 현황입니다. 이그드라실 앱에서 상세 통계를 확인하세요.")
  }

  app-launch {
    payload-uri ("#{value(this.appLaunchUri)}")
  }

  render {
    layout {
      section {
        content {
          if (exists(this.appLaunchUri)) {
            attribution-link {
              label {
                template ("🦅 이그드라실 앱에서 성장 상태 보기")
              }
              url ("#{value(this.appLaunchUri)}")
            }
          }
          // One UI 카드 1: 세계수 성장 & 지혜 포인트
          compound-card {
            content {
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("🌳 Yggdrasil World Tree")
                        style (Title_S)
                      }
                      text {
                        value ("성장 단계: #{value(this.koreanStageName)} (#{value(this.stage)})")
                        style (Detail_M_Soft)
                      }
                    }
                  }
                }
              }
              divider
              hbox {
                content {
                  vbox {
                    content {
                      text {
                        value ("성장 진행도")
                        style (Detail_M_Soft)
                      }
                      text {
                        value ("#{value(this.growthPercent)}%")
                        style (Title_L)
                      }
                    }
                  }
                  vbox {
                    content {
                      text {
                        value ("축적 지혜 (WP)")
                        style (Detail_M_Soft)
                      }
                      text {
                        value ("#{value(this.wisdomPoints)} WP")
                        style (Title_L)
                      }
                    }
                  }
                  vbox {
                    content {
                      text {
                        value ("수호 에이전트")
                        style (Detail_M_Soft)
                      }
                      text {
                        value ("#{value(this.guardianAgent)}")
                        style (Title_M)
                      }
                    }
                  }
                }
              }
            }
          }

          // One UI 카드 2: 해금된 자율 능력 목록
          compound-card {
            content {
              single-line {
                text {
                  value ("✨ 해금된 자율 능력")
                  style (Title_S)
                }
              }
              for-each (this.unlockedAbilities) {
                as (ability) {
                  paragraph {
                    value ("• #{value(ability)}")
                    style (Detail_L)
                  }
                }
              }
            }
          }

          // One UI 카드 3: 다음 단계 진화 조건
          compound-card {
            content {
              single-line {
                text {
                  value ("🌱 다음 단계 진화 조건")
                  style (Title_S)
                }
              }
              paragraph {
                value ("#{value(this.nextStageRequirement)}")
                style (Detail_M_Soft)
              }
            }
          }
        }
      }
    }
  }

  conversation-drivers {
    conversation-driver {
      template ("보안 상태 점검해줘")
    }
    conversation-driver {
      template ("판테온 상태 보여줘")
    }
    conversation-driver {
      template ("오늘 일정 브리핑해줘")
    }
  }
}
