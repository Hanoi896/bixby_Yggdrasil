    <!-- Consent 1: Terms of Service -->
    <string name="consent_tos_title">Terms of Service</string>
    <string name="consent_tos_content">Article 1 (Purpose)\nThese terms govern the rights, obligations, and responsibilities between the Company and Users regarding the use of Yggdrasil (the \"Service\").\n\nArticle 2 (Definitions)\n1. \"Service\" refers to the AI-based personal assistant service.\n2. \"User\" refers to anyone who agrees to these terms and uses the Service.\n\nArticle 3 (Effect of Terms)\nThese terms take effect when posted on the Service screen or notified to users through other means.</string>
    
    <!-- Consent 2: Privacy Policy -->
    <string name="consent_privacy_title">Privacy Information Collection Agreement</string>
    <string name="consent_privacy_content">1. Personal Information Collected\n- Required: Name, Contact, Date of Birth\n- Optional: Profile Photo, Interests, Schedule Info\n\n2. Purpose of Collection\n- Service provision and personalization\n- User-tailored AI learning\n- Service improvement and statistical analysis\n\n3. Retention Period\n- Until service termination\n- As required by applicable laws</string>
    
    <!-- Consent 3: Overseas Data Transfer -->
    <string name="consent_overseas_title">Overseas Data Transfer Agreement</string>
    <string name="consent_overseas_content">International Transfer of Personal Information\n\n1. Information Transferred\n- Name, Contact, Service Usage Records, AI Learning Data\n\n2. Countries and Timing\n- USA, Japan, EU, etc. (during service provision)\n\n3. Recipients\n- Amazon Web Services, Google Cloud Platform\n\n4. Purpose of Transfer\n- Cloud server operation and data storage\n\n5. Retention Period\n- 3 years after service termination\n\n※ You may refuse, but overseas server-based services may be limited.</string>
    
    <!-- Consent 4: Virtual Account Access -->
    <string name="consent_account_title">Virtual Account Access and Proxy Agreement</string>
    <string name="consent_account_content">Virtual Account Proxy Access Authorization\n\nI hereby authorize the Yggdrasil AI Agent with the following permissions:\n\n1. Scope of Authority\n- Check balance of my virtual account\n- Execute transfers within preset limits\n- Manage recurring payments and subscriptions\n\n2. Conditions\n- All transactions require prior approval\n- Per-transaction limit: $40\n- Daily limit: $160\n\n3. Security and Liability\n- All transactions recorded in real-time\n- Abnormal transactions immediately suspended\n- Company liable for non-user faults\n\n4. Revocation\n- Can be revoked anytime in settings</string>
    
    <!-- Consent 5: Micro Loan Terms -->
    <string name="consent_loan_title">Micro Loan Agreement</string>
    <string name="consent_loan_content">Micro Loan Terms\n\n【Compliant with Consumer Finance Protection Laws】\n\n1. Loan Conditions\n- Maximum per loan: $80 (100,000 KRW)\n- Maximum interest rate: 20% APR (within legal limits)\n- Repayment period: Up to 4 weeks\n\n2. Interest Calculation\n- Daily pro-rata calculation, no advance interest deduction\n- Late payment interest up to 20% APR\n\n3. Important Notice\n- Excessive borrowing may harm your financial health\n- Please borrow responsibly within your means\n\n※ This service is provided through registered lending institutions.</string>
    
    <!-- Consent 6: Marketing -->
    <string name="consent_marketing_title">Marketing Information Consent</string>
    <string name="consent_marketing_content">Marketing and Promotional Information Consent\n\n1. Information Received\n- New feature announcements\n- Events and promotions\n- Personalized service recommendations\n\n2. Delivery Methods\n- App push notifications\n- Email\n- SMS\n\n3. Withdrawal\n- Can opt-out anytime in settings\n\n※ This is optional; service use is not affected if declined.</string>
    
