structure (MemoryRecord) {
  description (뮤닌이 Niflheim 저장소에 보관 중인 단일 기억 레코드)
  property (id) {
    type (RecordId)
    min (Required) max (One)
  }
  property (category) {
    type (MemoryCategory)
    min (Required) max (One)
  }
  property (content) {
    type (MemoryContent)
    min (Required) max (One)
  }
  property (timestamp) {
    type (RecordTimestamp)
    min (Required) max (One)
  }
  property (isEncrypted) {
    type (IsEncrypted)
    min (Required) max (One)
  }
  property (signatureHash) {
    type (SignedHash)
    min (Required) max (One)
  }
}
