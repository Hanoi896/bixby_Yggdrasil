structure (MemoryQueryResult) {
  description (뮤닌의 기억 검색 및 회상 결과)
  property (query) {
    type (QueryTopic)
    min (Optional) max (One)
  }
  property (records) {
    type (MemoryRecord)
    min (Optional) max (Many)
  }
  property (totalCount) {
    type (MemoryTotalCount)
    min (Required) max (One)
  }
  property (summaryMessage) {
    type (MemorySummaryMessage)
    min (Required) max (One)
  }
}
