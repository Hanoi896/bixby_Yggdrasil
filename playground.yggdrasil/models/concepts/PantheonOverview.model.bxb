    min (Required) max (One)
  }
  property (tiers) {
    type (PantheonTier)
    min (Required) max (Many)
  }
  property (realms) {
    type (RealmStatus)
    min (Required) max (Many)
  }
  property (activeOdinMessage) {
    type (viv.core.Text)
    min (Required) max (One)
  }
}
