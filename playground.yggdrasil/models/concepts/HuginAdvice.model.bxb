structure (HuginAdvice) {
  description (휴긴의 지능적 추론 및 상황 브리핑 결과)
  property (topic) {
    type (QueryTopic)
    min (Required) max (One)
  }
  property (intent) {
    type (TierRole)
    min (Required) max (One)
  }
  property (thoughtProcess) {
    type (ThoughtProcess)
    min (Required) max (One)
  }
  property (recommendation) {
    type (Recommendation)
    min (Required) max (One)
  }
  property (actionPlan) {
    type (ActionPlan)
    min (Optional) max (Many)
  }
  property (confidence) {
    type (Confidence)
    min (Required) max (One)
  }
}
