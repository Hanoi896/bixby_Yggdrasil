structure (RealmStatus) {
  description (9대 세계 영역의 보안 및 가동 상태)
  property (name) {
    type (RealmName)
    min (Required) max (One)
  }
  property (accessLevel) {
    type (RealmAccessLevel)
    min (Required) max (One)
  }
  property (description) {
    type (RealmDescription)
    min (Required) max (One)
  }
  property (isSecure) {
    type (IsSecure)
    min (Required) max (One)
  }
  property (healthScore) {
    type (HealthScore)
    min (Required) max (One)
  }
}
