structure (AutonomousDialogueResult) {
  description (온디바이스 EXAONE 3.0 모델 및 Hugin 엔진에 의해 처리된 자율 대화 결과)
  
  property (utterance) {
    type (UserUtterance)
    min (Required) max (One)
    visibility (Private)
  }
  
  property (speechResponse) {
    type (SpeechResponse)
    min (Required) max (One)
  }
  
  property (displayText) {
    type (DisplayText)
    min (Required) max (One)
  }
  
  property (thoughtProcess) {
    type (ThoughtProcess)
    min (Optional) max (One)
  }
  
  property (tierName) {
    type (TierName)
    min (Optional) max (One)
  }
  
  property (actionName) {
    type (ActionName)
    min (Optional) max (One)
  }
  
  property (isLocalInference) {
    type (IsLocalInference)
    min (Required) max (One)
  }
  
  property (latencyMs) {
    type (LatencyMs)
    min (Optional) max (One)
  }
}
